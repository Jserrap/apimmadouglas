generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lutador {
  id        Int     @id @default(autoincrement())
  nome      String
  pais      String
  categoria String
  lutasA    Luta[]  @relation("LutadorA")
  lutasB    Luta[]  @relation("LutadorB")
}

model Card {
  id    Int    @id @default(autoincrement())
  nome  String
  data  DateTime
  lutas Luta[]
}

model Luta {
  id         Int      @id @default(autoincrement())
  peso       String?
  rounds     Int?
  data       DateTime?
  lutadorAId Int
  lutadorBId Int
  lutadorA   Lutador  @relation("A", fields: [lutadorAId], references: [id])
  lutadorB   Lutador  @relation("B", fields: [lutadorBId], references: [id])
}
